# Metadata for this package. Parsed as strict key=value, never sourced.
repo=https://github.com/holoviz/panel
tag_template=v{version}
subdir=.
install_method=pypi
# pytest-xdist is here to register panel's pytest.mark.xdist_group, not to run
# tests in parallel. Without it the mark is unknown, and panel's
# filterwarnings=error turns that warning into a collection error.
# pytest-timeout is here for the same reason: panel 1.10 sets `timeout = 300`
# in its pytest config, and without the plugin that is an "Unknown config
# option" PytestConfigWarning, which filterwarnings=error makes fatal.
pypi_extra_deps=pytest pytest-asyncio pytest-xdist pytest-timeout
# Coverage floor. Below this, a passing run means the test command stopped
# exercising Tornado rather than that Tornado is fine. Set ~20% under the
# measured value so ordinary drift does not trip it; raise it when coverage
# genuinely improves.
min_coverage=24
