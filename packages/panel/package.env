# Metadata for this package. Parsed as strict key=value, never sourced.
repo=https://github.com/holoviz/panel
tag_template=v{version}
subdir=.
install_method=pypi
# panel's own [tests] extra supplies pytest, pytest-asyncio and pytest-xdist.
# pytest-xdist is needed only to register panel's pytest.mark.xdist_group:
# without it the mark is unknown, and panel's filterwarnings=error turns that
# warning into a collection error.
optional_dependency_group=tests
# pytest-timeout is not in that extra (panel's CI gets it from pixi.toml), but
# panel 1.10 sets `timeout = 300` in its pytest config; without the plugin that
# is an "Unknown config option" PytestConfigWarning, which filterwarnings=error
# makes fatal.
pypi_extra_deps=pytest-timeout
# Coverage floor. Below this, a passing run means the test command stopped
# exercising Tornado rather than that Tornado is fine. Set ~20% under the
# measured value so ordinary drift does not trip it; raise it when coverage
# genuinely improves.
min_coverage=24
