# Package checkouts and per-run state aren't source of truth — they're
# regenerated by scripts/setup.sh and scripts/run_all.sh.
#
# Note: /checkouts/ holds the cloned downstream sources. The committed
# packages/ directory holds their *definitions* (pins, metadata, test scripts).
/checkouts/
/logs/
/results/*.txt

# Raw coverage data (SQLite databases, regenerated by run_all.sh).
/coverage/

# Generated HTML coverage reports. Built on demand by scripts/gen_reports.sh
# and uploaded as a CI artifact; not committed.
/coverage_html/
__pycache__/
*.pyc
